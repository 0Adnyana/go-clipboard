# Host-side production env file (NOT committed with secrets).
# Place next to compose.yaml on the host, or point ENV_FILE at it.
#
# IMAGE is set by the deploy script to a content digest (registry/name@sha256:…) — do not use `latest`.

# Required: absolute HTTPS origin of this deployment (no path/query/fragment).
# This is the public URL at the edge (Caddy); the app itself serves plain HTTP.
PUBLIC_BASE_URL=https://clip.example.com

# Database. Two mutually exclusive options:
#
# 1. Bundled (default): keep the `bundled-db` profile on and set a password.
#    Compose runs Postgres as part of this stack on the private network, and
#    DATABASE_URL is derived from POSTGRES_PASSWORD.
# 2. External or managed: comment out both lines below, then set DATABASE_URL
#    to the full connection string. Managed providers normally need
#    sslmode=require. The bundled Postgres container is then never started,
#    and backup.sh / restore.sh switch to client tools in a throwaway
#    container. The `pgdata` volume is left untouched, not deleted.
COMPOSE_PROFILES=bundled-db
POSTGRES_PASSWORD=change-me

# DATABASE_URL=postgres://user:password@db.example.com:5432/go_clipboard?sslmode=require

# Host-side published port for the app. The container always listens on 8080;
# change this only when 8080 is already taken on the host, and point the edge
# proxy at the same value. Defaults to 8080 when unset.
APP_PORT=8082

# Required: IP of the immediate peer whose X-Forwarded-For is honoured, as the
# app container sees it. This host is not on Tailscale, so it is a LAN address:
# the edge's own LAN IP when the edge is on this LAN, or the subnet router's LAN
# IP when the edge arrives through Tailscale with SNAT on. Never a 100.x address.
TRUSTED_PROXY=192.168.0.1
