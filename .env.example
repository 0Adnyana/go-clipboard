# Homebrew Postgres creates a superuser named after your macOS account (not "postgres")
# and uses trust auth on the local socket with no password. The conventional
# postgres:postgres@localhost URL fails with an authentication error that
# looks like a misconfiguration rather than the wrong username.
#
# Homebrew listens on the /tmp socket by default; use host=/tmp rather than
# localhost:5432 unless your pg_hba.conf enables trust/passwordless TCP.
#
# Replace <macos-username> with your own account name (`whoami`).
DATABASE_URL="postgres://<macos-username>@/go_clipboard?host=/tmp&sslmode=disable"

PORT=8080
PROXY_PORT=3000
VITE_PORT=5173
