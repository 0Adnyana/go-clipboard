# Homebrew Postgres creates a superuser named after your macOS account (not "postgres")
# and uses trust auth on the local socket with no password. The conventional
# postgres:postgres@localhost URL fails with an authentication error that
# looks like a misconfiguration rather than the wrong username.
#
# Homebrew listens on the /tmp socket by default; use host=/tmp rather than
# localhost:5432 unless your pg_hba.conf enables trust/passwordless TCP.
#
# Replace <macos-username> with your own account name (`whoami`).
DATABASE_URL="postgres://<macos-username>@/go_clipboard?host=/tmp&sslmode=disable"

PORT=8080
PROXY_PORT=3000
VITE_PORT=5173

# Rate limiting (anonymous tier). TRUSTED_PROXY is the immediate peer whose
# X-Forwarded-For header is honoured. Widening this trusts the header from more
# sources and can allow IP spoofing past the limiter.
#
# Development default (below): trust the local Caddy hop.
# Production: set TRUSTED_PROXY to the edge proxy IP (see deploy/env.example).
TRUSTED_PROXY=127.0.0.1
IPV6_PREFIX=64
RATELIMIT_CREATE_RATE=10
RATELIMIT_CREATE_WINDOW=1m
RATELIMIT_AVAIL_RATE=30
RATELIMIT_AVAIL_WINDOW=1m
RATELIMIT_MAX_KEYS=10000

# Production only: absolute HTTPS origin at the edge (no path/query/fragment).
# Leave unset for local development.
# PUBLIC_BASE_URL=https://clip.example.com
